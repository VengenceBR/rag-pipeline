# --- Gemini (embeddings + generation) ---
GEMINI_API_KEY=

# --- Pinecone (dense vector store) ---
# Leave PINECONE_API_KEY unset to run entirely on the local numpy store (no external calls).
PINECONE_API_KEY=
PINECONE_INDEX_NAME=rag-pipeline

# --- Models ---
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768
GENERATION_MODEL=gemini-3.6-flash

# --- Retrieval tuning ---
DENSE_TOP_K=25
SPARSE_TOP_K=25
RRF_K=60
RERANK_TOP_K=8

# --- Chunking ---
CHUNK_SIZE_TOKENS=800
CHUNK_OVERLAP_TOKENS=120

# --- Storage paths (local dev store + bm25 indexes + embedding cache) ---
DATA_DIR=./data
INDEX_DIR=./.indexes

# --- API auth ---
# Per-company API keys live in API_KEYS_FILE (gitignored, like .env — never commit it).
# Manage keys with: python -m rag.cli keys create --name "..." --company acme
API_KEYS_FILE=./api_keys.json
REQUIRE_API_KEY=true
RATE_LIMIT_PER_MINUTE=20
